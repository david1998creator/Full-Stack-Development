# ==============================================================================
# Persistent CrewAI 8-Agent Software Engineering Framework
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and insert your personal API keys:
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini (Fast Orchestration, Planning & Verification)
# ------------------------------------------------------------------------------
# Default model: gemini-2.5-flash / gemini-2.5-flash-lite
# Obtain a free or pay-as-you-go key at Google AI Studio:
# https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. OpenRouter (Deep Reasoning & Specialized Coding Models)
# ------------------------------------------------------------------------------
# Default model: qwen/qwen-2.5-coder-32b-instruct (also supports Claude, GPT-4o, DeepSeek)
# Obtain an API key at:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. Optional Inference Providers (Ultra-Fast Fallbacks)
# ------------------------------------------------------------------------------
# Groq (Llama-3 fast inference)
# https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM (Enterprise API access)
# https://build.nvidia.com/
NVIDIA_API_KEY=

# ------------------------------------------------------------------------------
# 4. Optional GitHub Integration
# ------------------------------------------------------------------------------
# If left blank, the framework uses MockGitHubAdapter (100% offline simulation).
# If provided, enables live pull requests, branch creation, and sync to real GitHub repositories:
GITHUB_TOKEN=
