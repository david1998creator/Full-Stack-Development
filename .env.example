# ==============================================================================
# Persistent CrewAI 10-Role Multi-Agent SDLC Framework
# Environment Configuration Template (.env)
# ==============================================================================
# To start, copy this file to '.env':
#   Windows:   copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# NOTE: You only need ONE active key to run live!
# Free options (Google Gemini & Groq) work 100% out of the box with zero spend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini [100% FREE TIER AVAILABLE]
# ------------------------------------------------------------------------------
# Highly recommended: 15 Requests/Min free with generous daily token limits.
# Used for: Coordinator planning, Architect system design, DB modeling.
# Obtain key: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Groq Cloud [100% FREE TIER AVAILABLE]
# ------------------------------------------------------------------------------
# Highly recommended: Ultra-fast sub-second Llama-3.3 70B & 8B inference.
# Used for: Developer implementation, QA test generation, Security auditing.
# Obtain key: https://console.groq.com/keys
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 3. OpenRouter [Free & Low-Cost Coding Models]
# ------------------------------------------------------------------------------
# Access to Qwen 2.5 Coder, DeepSeek R1/V3, Claude 3.5 Sonnet, and free models.
# Obtain key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 4. OpenAI [Paid Standard]
# ------------------------------------------------------------------------------
# Access to GPT-4o, GPT-4o-mini, and o1 reasoning models.
# Obtain key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. NVIDIA NIM [Free Trial Credits Available]
# ------------------------------------------------------------------------------
# High-throughput Llama 3 models hosted on NVIDIA DGX Cloud.
# Obtain key: https://build.nvidia.com/
NVIDIA_API_KEY=

# ------------------------------------------------------------------------------
# 6. Local Ollama [100% FREE & PRIVATE - No Key Required]
# ------------------------------------------------------------------------------
# If running models locally on your GPU/CPU (e.g. ollama run llama3):
# Default: http://localhost:11434
OLLAMA_BASE_URL=

# ------------------------------------------------------------------------------
# 7. Optional GitHub Integration
# ------------------------------------------------------------------------------
# If left blank, the framework uses MockGitHubAdapter (100% offline simulation).
# If provided, enables live pull requests and commits to remote GitHub repos:
GITHUB_TOKEN=
